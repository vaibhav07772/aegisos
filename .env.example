# AegisOS Environment Configuration

# ─── Groq API (Required) ───
GROQ_API_KEY=gsk_YOUR_KEY_HERE
DEFAULT_MODEL=openai/gpt-oss-20b

# ─── Optional: GitHub Token (for higher rate limits) ───
# GITHUB_TOKEN=ghp_...

# ─── Rate Limits ───
GROQ_TPM_LIMIT=8000
GROQ_RPD_LIMIT=1000

# ─── Logging ───
LOG_LEVEL=INFO
LOG_DIR=./logs